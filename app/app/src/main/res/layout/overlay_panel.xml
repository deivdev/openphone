<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#E0222222"
    android:padding="12dp">

    <!-- Header with drag handle and collapse/close -->
    <LinearLayout
        android:id="@+id/overlay_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="OpenPhone"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_collapse"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:text="—"
            android:textColor="#FFFFFF"
            android:background="#444444"
            android:textSize="14sp" />

        <Button
            android:id="@+id/btn_close"
            android:layout_width="40dp"
            android:layout_height="32dp"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:background="#444444"
            android:layout_marginStart="4dp"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Content (collapsible) -->
    <LinearLayout
        android:id="@+id/overlay_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <EditText
            android:id="@+id/input_goal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="What should I do?"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:backgroundTint="#555555"
            android:textSize="13sp"
            android:singleLine="true"
            android:padding="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="8dp">

            <Button
                android:id="@+id/btn_run"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="Run"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btn_stop"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Stop"
                android:textSize="12sp"
                android:enabled="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_log"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="120dp"
            android:scrollbars="vertical"
            android:text=""
            android:textColor="#AAAAAA"
            android:textSize="10sp"
            android:fontFamily="monospace"
            android:paddingTop="8dp" />
    </LinearLayout>
</LinearLayout>
